{
  "schemaVersion": 2,
  "activityId": 1004,
  "methodology": { "id": 2004, "version": 2 },
  "evidenceSchema": "DMRVN_EVIDENCE_V4",
  "evidenceValidation": { "kind": "METHODOLOGY_JSON_SCHEMA_V1", "version": 1 },
  "coefficientNotice": "Integration test only. This is not an approved solar carbon methodology or credit calculation.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["measurements", "emissionsFactorTco2ePerMwh", "projectEmissionsTco2e"],
    "properties": {
      "measurements": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generationMwh"],
          "properties": { "generationMwh": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" } }
        }
      },
      "emissionsFactorTco2ePerMwh": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
      "projectEmissionsTco2e": { "type": "string", "pattern": "^[0-9]+$" }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["baselineEmissions", "projectEmissions", "netReduction", "measurementCount"],
    "properties": {
      "baselineEmissions": { "$ref": "#/$defs/tco2e" },
      "projectEmissions": { "$ref": "#/$defs/tco2e" },
      "netReduction": { "$ref": "#/$defs/tco2e" },
      "measurementCount": { "type": "integer", "minimum": 1, "maximum": 100 }
    },
    "$defs": {
      "tco2e": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "unit", "scale"],
        "properties": {
          "value": { "type": "string", "pattern": "^[0-9]+$" },
          "unit": { "const": "tCO2e" },
          "scale": { "const": 4 }
        }
      }
    }
  },
  "runtime": { "kind": "JSON_WASM_V2", "abiVersion": 2, "export": "compute" }
}
