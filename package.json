{
  "name": "dmrvn-methodologies",
  "version": "0.1.0",
  "private": true,
  "description": "Public DMRVN methodology sources and reproducible WASM packages",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.js",
    "setup:wasm": "node scripts/setup-json-wasm-toolchain.js",
    "build:json": "node scripts/json-abi-package.js",
    "verify:reproducible": "node scripts/verify-json-reproducible.js",
    "test": "node --test",
    "verify": "node scripts/verify.js",
    "verify:all": "node scripts/verify-all.js",
    "verify:json": "node scripts/json-abi-package.js --verify",
    "sync:workspace-fixtures": "npm run verify:all && node scripts/sync-workspace-fixtures.js",
    "verify:workspace-fixtures": "npm run verify:all && node scripts/sync-workspace-fixtures.js --check"
  },
  "dependencies": { "ajv": "8.20.0", "ethers": "5.8.0", "wabt": "1.0.37" }
}
